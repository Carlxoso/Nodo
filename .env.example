# Copia este archivo a .env (no se sube al repo)
POSTGRES_USER=nodo
POSTGRES_PASSWORD=cambiame
POSTGRES_DB=nodo
POSTGRES_PORT=5432
API_PORT=3000
JWT_SECRET=cambiame-por-algo-largo
# 32 bytes en hex para AES-256-GCM (datos sensibles de familias)
DATA_KEY=

# --- Solo en la nube (Railway) ---
# DATABASE_URL lo inyecta Railway (referencia a la base PostGIS).
# NODO_CLAVE_INICIAL: si la base está vacía, crea operador@nodo.test y admin@nodo.test con esta clave (mín. 8).
# UPLOADS_DIR: carpeta del volumen persistente para las fotos (ej. /data/uploads).
